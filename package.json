{
  "name": "com.hacha.livecoding-editor",
  "version": "0.1.0",
  "displayName": "LiveCoding Editor",
  "description": "A small code editor that lives in your scene (world-space Canvas) and reads a hardware keyboard directly, without a soft keyboard or OS text field. Language-agnostic: syntax highlighting and diagnostics are injected by the host. Useful for in-game consoles or live coding in VR/XR.",
  "unity": "6000.0",
  "dependencies": {
    "com.unity.inputsystem": "1.11.0",
    "com.unity.ugui": "2.0.0"
  },
