    "name": "hacha",
    "url": "https://github.com/hacha"
  },
  "keywords": [
    "live coding",
    "code editor",
    "text editor",
    "xr",
    "vr",
    "keyboard"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hacha/unity-livecoding-editor.git"
  },
  "documentationUrl": "https://github.com/hacha/unity-livecoding-editor#readme",
  "changelogUrl": "https://github.com/hacha/unity-livecoding-editor/blob/main/CHANGELOG.md",
  "licensesUrl": "https://github.com/hacha/unity-livecoding-editor/blob/main/LICENSE.md"
